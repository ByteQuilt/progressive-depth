{
  "name": "@bytequilt/progressive-depth",
  "version": "1.1.0",
  "description": "A content format for how people actually read. Three layers of depth per section, scaled by the golden ratio.",
  "author": "Brandon D. Phillips <brandon.phillips@bytequilt.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteQuilt/progressive-depth.git"
  },
  "bugs": {
    "url": "https://github.com/ByteQuilt/progressive-depth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://bytesbybrandon.com/blog/introducing-progressive-depth-a-blog-format-for-how-people-actually-read",
  "keywords": [
    "progressive-disclosure",
    "blog",
    "content-format",
    "markdoc",
    "keystatic",
    "golden-ratio",
    "reading-modes",
    "progressive-depth"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints styles.css",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "publish:npmjs": "npm publish --access public --registry=https://registry.npmjs.org/ --@bytequilt:registry=https://registry.npmjs.org/",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com/ --@bytequilt:registry=https://npm.pkg.github.com/",
    "release": "pnpm run publish:npmjs && pnpm run publish:github",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^18.2.0",
    "jsdom": "^30.1.1",
    "publint": "^0.3.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.3"
  }
}
